+    const char *real = ctx->payload->cmd == NM_CMD_ADD_RULE && !(flags & NM_FLAG_WHITEOUT) ? ctx->path : NULL;
+    int rc = nm_queue_rule(ctx->payload, ctx->args, flags, NULL, vpath, real);
+    /* A previous batch may fail while the current record is successfully queued. */
+    if (entry) {
+        entry->next = ctx->deleted[bucket]; ctx->deleted[bucket] = entry;
+    }
+    return rc;
