+static int nm_queue_module_rule(struct nm_walk *ctx, unsigned flags, const char *vpath) {
+    struct nm_del_seen *entry = NULL;
+    unsigned bucket = 0;
+    if (ctx->payload->cmd == NM_CMD_DEL_RULE) {
+        size_t len = strlen(vpath);
+        if (sizeof(struct nm_del_hdr) + len > sizeof(ctx->payload->buffer)) return -E2BIG;
+        unsigned hash = 2166136261U;
+        for (size_t i = 0; i < len; i++) hash = (hash ^ (unsigned char)vpath[i]) * 16777619U;
+        bucket = hash % NM_DEL_BUCKETS;
+        for (entry = ctx->deleted[bucket]; entry; entry = entry->next)
+            if (entry->len == len && !memcmp(entry->path, vpath, len)) return 0;
+        entry = malloc(sizeof(*entry) + len);
+        if (!entry) return -ENOMEM;
+        entry->len = len;
+        memcpy(entry->path, vpath, len);
